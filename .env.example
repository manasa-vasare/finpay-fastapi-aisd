# FinPay Environment Configuration (Optional)
# The application includes sensible built-in defaults and runs out-of-the-box without this file.

# Database connection URL (defaults to local SQLite database)
FINPAY_DB=sqlite:///./finpay.db

# JWT Signing Secret (change in production)
FINPAY_SECRET=finpay-dev-secret-change-me-please-32b
